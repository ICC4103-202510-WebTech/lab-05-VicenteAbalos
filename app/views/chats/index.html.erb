<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat Index</title>
</head>
<body>
    <div class="container-fluid bg-primary">
        <h1>Chat Index</h1>
    </div>
    <div class="container-sm bg-secondary">
        <table class="table table-striped">
            <tr>
                <th>Chat</th>
                <th>Chat Page</th>
            </tr>
            <% @chats.each do |chat| %>
                <tr>
                    <td>
                        Chat from <%= User.find(chat.sender_id).first_name %> to <%= User.find(chat.receiver_id).first_name %>
                    </td>
                    <td>
                        <button type="button" class="btn bg-primary-subtle"><%= link_to("View",chat_path(chat)) %></button>
                    </td>
                </tr>
            <% end%>
        </table>
    </div>
    <div>
        <button type="button" class="btn bg-success-subtle"><%= link_to "New Chat", new_chat_path %></button>
    </div>
</body>