<div class="container-sm">
<%= form_with model: @chat do |form| %>
    <div class="container-sm d-flex p-2">
        <%=form.label :sender_id, "Sender" %>
        <%=form.select :sender_id, User.all.collect { |user| [user.first_name,user.id]}, class: 'form-control'%>
    </div>
    <div class="container-sm d-flex p-2">
        <%=form.label :receiver_id, "Receiver" %>
        <%=form.select :receiver_id, User.all.collect { |user| [user.first_name,user.id]}, class: 'form-control'%>
    </div>
    <div>
        <%= form.submit "Save", class:"btn btn-primary" %><%= link_to "Cancel",chats_path, class:"btn btn-danger"%>
    </div>
<% end %>
</div>
