
    <div class="container-sm card bg-secondary-subtle">
        <h1 class="text-center card-title bg-danger-subtle"><%= @sender.first_name %> & <%= @receiver.first_name %></h1>
        <div class="card-body bg-secondary-subtle">
            <ul>
            <li class="card-text bg-success-subtle">
                Sender ID: <%=@chat.sender_id %><br>
            </li>
            <li class="card-text bg-warning-subtle">
                Receiver ID: <%=@chat.receiver_id %>
            </li>
            <li class="card-text bg-success-subtle">
                Created on <%= @chat.created_at %>
            </li>
            <li class="card-text bg-warning-subtle">
                Last updated on <%= @chat.updated_at %>
            </li>
            </ul>
        </div>
        <br>
    </div>
    <div class="container-sm">
        <table class="table">
            <tr class="col-12">
                <th class="bg-primary-subtle col-3">Sender</th>
                <th class="bg-primary-subtle col-3">Receiver</th>
                <th class="bg-primary-subtle col-6">Message</th>
            </tr>
            <% @messages.each do |message|%>
                <tr class="col-12">
                    <%if message.user_id == @sender.id%>
                        <td>
                            <%=@sender.first_name%>
                        </td>
                        <td>
                            <%=@receiver.first_name%>
                        </td>
                    <%end%>
                    <%if message.user_id == @receiver.id%>
                        <td>
                            <%=@receiver.first_name%>
                        </td>
                        <td>
                            <%=@sender.first_name%>
                        </td>
                    <%end%>
                    <td><%=message.body%><td>
                </tr>
            <% end%>
        </table>
    </div>

    <div class="container-sm">
        <%= link_to "Edit", edit_chat_path(@chat), class:"btn btn-info"%>
        <%= link_to "Back",chats_path, class:"btn bg-light" %>
    </div>
