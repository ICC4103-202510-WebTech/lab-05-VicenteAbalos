<div class="container-fluid col-6 bg-info">
      <h2>Sign up</h2>
</div>

<div class="container-fluid col-6 bg-success-subtle">
<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <div class="row">
    <div class="col-3">
    </div>
    <div class="field col-3">
      <%= f.label :email %><br />
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>
  </div>

  <div class="row">
    <div class="col-3">
    </div>
    <div class="field col-3">
      <%= f.label :first_name %><br />
      <%= f.text_field :first_name, autocomplete: "First Name" %>
    </div>
  </div>
  <div class="row">
    <div class="col-3">
    </div>
    <div class="field col-3">
      <%= f.label :last_name %><br />
      <%= f.text_field :last_name, autocomplete: "First Name" %>
    </div>
  </div>

  <div class="row">
    <div class="col-3">
    </div>
    <div class="field col-3">
      <%= f.label :password %>
      <% if @minimum_password_length %>
      <em>(<%= @minimum_password_length %> characters minimum)</em>
      <% end %><br />
      <%= f.password_field :password, autocomplete: "new-password" %>
    </div>
  </div>

  <div class="row">
    <div class="col-3">
    </div>
    <div class="field col-3">
      <%= f.label :password_confirmation %><br />
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>
  </div>

  <div class="row">
    <div class="col-3">
    </div>
    <div class="actions col-3">
      <%= f.submit "Sign up" %>
    </div>
  </div>
<% end %>
</div>

<div class="container-fluid col-6 bg-info">
      <%= render "devise/shared/links" %>
</div>