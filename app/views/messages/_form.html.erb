<div class="container-sm">
    <%= form_with model: @message do |form| %>
        <div class="container-sm d-flex p-2">
            <%=form.label :chat_id, "Chat" %>
            <%=form.select :chat_id, @chat.collect { |chat| [("Chat by "+User.find(chat.sender_id).first_name+" & "+User.find(chat.receiver_id).first_name),chat.id]}, class: 'form-control'%>
        </div>
        <div class="container-sm d-flex p-2">
            <%=form.label :user_id, "User" %>
            <%=form.select :user_id, [[@users.first_name,@users.id]], class: 'form-control'%>
        </div>
        <div>
            <%=form.label :body, "Body"%>
            <%=form.text_field :body, class: 'form-control'%>
        </div>
        <div>
            <%= form.submit "Save" %>
        </div>
    <% end %>
</div>
