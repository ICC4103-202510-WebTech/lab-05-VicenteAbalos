<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= @message.chat_id %></title>
</head>
<body class="bg-primary-subtle">
    <div class="container-sm card bg-secondary-subtle">
        <h1 class="text-center card-title bg-danger-subtle"><%= @message.chat.sender.first_name %>'s Message to <%= @message.chat.receiver.first_name %></h1>
        <div class="card-body bg-secondary-subtle">
            <li class="card-text bg-warning-subtle">
                Chat ID: <%=@message.chat_id %>
            </li>
            <li class="card-text bg-success-subtle">
                Sender ID: <%=@message.user_id %>
            </li>
            <li class="card-text bg-warning-subtle">
                Message body: <%=@message.body %>
            </li>
            <li class="card-text bg-success-subtle">
                Created on <%= @message.created_at %>
            </li>
            <li class="card-text bg-warning-subtle">
                Last updated on <%= @message.updated_at %>
            </li>
            <br>
            </br>
            <div class="container-lg">
                <table class="container-sm bg-success-subtle">
                    <tr>
                        <th class="col-4">Sender</th>
                        <th class="col-4">Chat</th>
                        <th>Link</th>
                    </tr>
                    <tr class="bg-warning-subtle">
                        <td><%= @sender.first_name%> <%= @sender.last_name%></td>
                        <td>Chat between <%=@chatsender.first_name%> & <%=@chatreceiver.first_name%></td>
                        <td><%=link_to "Chat", chat_path(@chat), class:"btn bg-primary-subtle"%></td>
                    </tr>
                </table>
            </div>
        </div>
        <div>
            
        </div>
    </div>
</body>
<footer>
    <div class="container-sm">
        <%= link_to "Edit", edit_message_path(@message), class:"btn btn-info"%>
        <%= link_to "Back",messages_path, class:"btn bg-light" %>
    </div>
</footer>