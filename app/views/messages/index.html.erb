<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Message Index</title>
</head>
<body>
    <div class="container-fluid bg-primary">
        <h1>Message Index</h1>
    </div>
    <div class="container-sm bg-secondary">
        <table class="table table-striped">
            <tr>
                <th>Message</th>
                <th>Message Page</th>
                <th>Edit Message</th>
            </tr>
            <% @messages.each do |message| %>
                <tr>
                    <td>
                        Message for Chat #<%= message.chat_id %>
                    </td>
                    <td>
                        <%= link_to("View",message_path(message), class:"btn bg-primary-subtle") %>
                    </td>
                    <td>
                        <%if can? :edit, message%>
                            <%= link_to("Edit",edit_message_path(message), class:"btn bg-primary-subtle") %>
                        <%end%>
                    </td>
                </tr>
            <% end%>
        </table>
    </div>
    <div class="container-sm">
        <%= link_to "New Message", new_message_path, class:"btn bg-success-subtle" %>
    </div>
</body>