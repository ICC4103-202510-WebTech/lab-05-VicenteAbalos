<body>
    <div class="container-fluid bg-primary">
        <h1>User Index</h1>
        <%unless user_signed_in?%>
            <%=link_to "Sign In", user_session_path, class:"btn btn-success"%>
        <%end%>
    </div>
    <div class="container-sm bg-secondary">
        <table class="table table-striped">
            <tr>
                <th>User</th>
                <th>User Page</th>
                <th>Edit User</th>
                <th>Message Count</th>
            </tr>
            <% @users.each do |user| %>
                    <tr>
                        <td>
                            <%= user.first_name %>
                        </td>
                        <td>
                            <% if can? :show, user %>
                                <%= link_to("View",user_path(user), class:"btn bg-primary-subtle") %>
                            <%end%>
                        </td>
                        <td>
                            <% if user==current_user %>
                                <%= link_to("Edit",edit_user_registration_path(user), class:"btn bg-primary-subtle") %>
                            <%end%>
                        </td>
                        <td>
                            <%if can? :show, user %>
                                <%= user.messages.count%>
                            <% else %>
                                <p>[Classified]</p>
                            <%end%>
                        </td>
                    </tr>
            <% end%>
        </table>
    </div>
    <div class="container-sm">
        <% unless user_signed_in? %>
        <%= link_to "New User", new_user_registration_path, class:"btn bg-success-subtle" %>
        <%end%>
    </div>
</body>