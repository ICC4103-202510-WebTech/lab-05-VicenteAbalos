<h1>User Form</h1>
<div class="container-sm">
<%= form_with model: @user do |form| %>
    <div class="container-sm">
        <%=form.label :first_name, "Name", class: "bg-secondary-subtle" %>
        <%=form.text_field :first_name, class: 'form-control', required: true %>
    </div>
    <div class="container-sm">
        <%=form.label :last_name, "Last Name", class: "bg-secondary-subtle" %>
        <%=form.text_field :last_name, class: 'form-control', required: true %>
    </div>
    <div class="container-sm">
        <%=form.label :email, "Email", class: "bg-secondary-subtle" %>
        <%=form.text_field :email, class: 'form-control', required: true %>
    </div>
    <div>
        <%= form.submit "Save" %>
    </div>
<% end %>
</div>
<div>
    <% if @user.errors.any? %>
        <div class="container-sm">
        <% @user.errors.each do |error| %>
            <h1>
            <span class="badge text-bg-success">
                <%= error.full_message %>
            </span>
            </h1>
        <% end %>
        </div>
    <% end %>
</div>