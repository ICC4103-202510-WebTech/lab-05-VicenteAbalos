<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= @user.first_name %></title>
</head>
<body class="bg-primary-subtle">
    <div class="container-sm card bg-secondary-subtle">
        <h1 class="text-center card-title bg-danger-subtle"><%= @user.first_name %> <%= @user.last_name %></h1>
        <div class="card-body bg-secondary-subtle">
            <li class="card-text bg-warning-subtle">
                <a href="#"><%=@user.email %></a>
            </li>
            <li class="card-text bg-success-subtle">
                Created on <%= @user.created_at %>
            </li>
            <li class="card-text bg-warning-subtle">
                Last updated on <%= @user.updated_at %>
            </li>
        </div>
        <div class="card-body bg-secondary-subtle">
            <table class="table">
                <th>Chat</th>
                <th>Sender</th>
                <th>Receiver</th>
            <% @chats.each do |chat| %>
                <tr>
                    <td><%= chat.id %></td>
                    <td><%= @user.first_name %></td>
                    <td><%= chat.receiver.first_name %></td>
                </tr>
            <% end %>
            <% @chatss.each do |chat| %>
                <tr>
                    <td><%= chat.id %></td>
                    <td><%= chat.sender.first_name %></td>
                    <td><%= @user.first_name %></td>
                </tr>
            <% end %>
            </table>
            <table class="table">
            <th class="bg-primary-subtle">Messages</th>
            <% @messages.each do |message| %>
                <tr>
                    <td class="bg-success-subtle">Chat #<%= message.chat_id%></td>
                    <td class="bg-success-subtle"><%= message.body %></td>
                    <td class="bg-success-subtle"><%=link_to "Message", message_path(message), class:"btn bg-primary-subtle"%></td>
                </tr>
            <% end %>
            </table>
        </div>
    </div>
</body>
<footer>
    <div class="container-sm">
        <% if @user==current_user %>
            <%= link_to "Edit", edit_user_path(@user), class:"btn btn-info"%>
        <%end%>
        <%= link_to "Back",users_path, class:"btn btn-light" %>
    </div>
</footer>